\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Controlled regression: EWC benefit $\sim $ $\log (\text  {params}) + H_0$. $H_0$ $p$ tests topology's contribution beyond model size. Bold: $p < 0.05$.}}{5}{table.3}\protected@file@percent }
\newlabel{tab:capacity_control}{{3}{5}{Controlled regression: EWC benefit $\sim $ $\log (\text {params}) + H_0$. $H_0$ $p$ tests topology's contribution beyond model size. Bold: $p < 0.05$}{table.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Partial Spearman $\rho $ of $H_0$ with EWC benefit after controlling for each baseline metric. Bold: $p < 0.05$. $H_0$ retains significance on CIFAR-100 and RESISC-45 regardless of which baseline is controlled, including the trivial L2 weight norm. No baseline retains significance after controlling for $H_0$ except weight norm and Fisher trace on RESISC-45.}}{5}{table.4}\protected@file@percent }
\newlabel{tab:baselines}{{4}{5}{Partial Spearman $\rho $ of $H_0$ with EWC benefit after controlling for each baseline metric. Bold: $p < 0.05$. $H_0$ retains significance on CIFAR-100 and RESISC-45 regardless of which baseline is controlled, including the trivial L2 weight norm. No baseline retains significance after controlling for $H_0$ except weight norm and Fisher trace on RESISC-45}{table.4}{}}
