\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Per-dataset partial effect of $\tilde  {H}_0$ (z-scored within dataset) from the pooled interaction model, with 95\% clustered bootstrap CIs. Bold: CI excludes zero.}}{7}{table.6}\protected@file@percent }
\newlabel{tab:partial_effects}{{6}{7}{Per-dataset partial effect of $\tilde {H}_0$ (z-scored within dataset) from the pooled interaction model, with 95\% clustered bootstrap CIs. Bold: CI excludes zero}{table.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Per-dataset partial effects of within-dataset $\tilde  {H}_0$ with 95\% clustered bootstrap CIs. Left: effect on retention (ret@10); only CUB-200 excludes zero. Right: effect on EWC benefit; CIFAR-100 and RESISC-45 exclude zero while CUB-200 does not, demonstrating dataset-dependent moderation (block permutation $p = 0.046$). The asymmetry between panels shows that topology relates to forgetting and mitigation benefit through different pathways.}}{7}{figure.3}\protected@file@percent }
\newlabel{fig:pooled_interaction}{{3}{7}{Per-dataset partial effects of within-dataset $\tilde {H}_0$ with 95\% clustered bootstrap CIs. Left: effect on retention (ret@10); only CUB-200 excludes zero. Right: effect on EWC benefit; CIFAR-100 and RESISC-45 exclude zero while CUB-200 does not, demonstrating dataset-dependent moderation (block permutation $p = 0.046$). The asymmetry between panels shows that topology relates to forgetting and mitigation benefit through different pathways}{figure.3}{}}
