\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces $H_0$ persistence vs.\ EWC benefit across 19 architectures per dataset. Strong positive correlation on CIFAR-100 ($\rho = 0.76$) and RESISC-45 ($\rho = 0.86$); null on CUB-200 ($\rho = 0.31$). Points colored by architecture family; dashed line is OLS fit. WRN-ladder points (purple diamonds) span the full H0 range within a single architecture family.}}{4}{figure.1}\protected@file@percent }
\newlabel{fig:h0_ewc_scatter}{{1}{4}{$H_0$ persistence vs.\ EWC benefit across 19 architectures per dataset. Strong positive correlation on CIFAR-100 ($\rho = 0.76$) and RESISC-45 ($\rho = 0.86$); null on CUB-200 ($\rho = 0.31$). Points colored by architecture family; dashed line is OLS fit. WRN-ladder points (purple diamonds) span the full H0 range within a single architecture family}{figure.1}{}}
