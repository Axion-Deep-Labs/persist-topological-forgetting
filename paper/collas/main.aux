\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces WRN-28-$k$ width ladder: $H_0$ decreases monotonically with width ($\rho = -1.0$) on all 3 datasets, consistent with wider networks having smoother, less fragmented landscapes.}}{6}{figure.2}\protected@file@percent }
\newlabel{fig:wrn_ladder}{{2}{6}{WRN-28-$k$ width ladder: $H_0$ decreases monotonically with width ($\rho = -1.0$) on all 3 datasets, consistent with wider networks having smoother, less fragmented landscapes}{figure.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Per-dataset LOAO forgetting prediction. $\rho $: Spearman correlation between predicted and observed retention. Perm.\ $p$: permutation test for topology improvement over params. Bold: $p < 0.05$ (does not survive Bonferroni).}}{6}{table.5}\protected@file@percent }
\newlabel{tab:loao}{{5}{6}{Per-dataset LOAO forgetting prediction. $\rho $: Spearman correlation between predicted and observed retention. Perm.\ $p$: permutation test for topology improvement over params. Bold: $p < 0.05$ (does not survive Bonferroni)}{table.5}{}}
